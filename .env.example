# Sales chat (/api/sales-chat). Required for the chat window to answer.
ANTHROPIC_API_KEY=

# "Have someone contact me" requests from the chat and the contact form, delivered
# to info@wildcatiq.ai (fixed in followup.ts). Optional: without the key and sender
# the assistant tells the visitor to book a demo instead.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=WildcatIQ

# GTM tracking (/api/track): the GTM Supabase project's URL and secret key.
# Writes happen only on the production deployment, from wildcatiq.ai pages.
GTM_SUPABASE_URL=
GTM_SUPABASE_SECRET_KEY=
